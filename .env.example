# Optional. The app works, including the audited demo ZIP, without credentials.
# Docker Compose loads .env; local Java runs read exported environment variables.
PORT=8080
BIND_ADDRESS=127.0.0.1
REPOMEDIC_DATA_DIR=.repomedic
REPOMEDIC_SANDBOX_ENABLED=false

# Opt-in chat-completions endpoint. Relevant source snippets leave this machine
# only when ALL three AI settings are configured. Do not commit actual values.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Development-only Vite proxy target; the production UI uses same-origin /api.
VITE_API_PROXY_TARGET=http://localhost:8080
